<button
  type="button"
  class="btn btn-primary"
  data-bs-toggle="offcanvas"
  data-bs-target="#<%= drawer_id %>"
  aria-controls="<%= drawer_id %>"
>
  Open drawer
</button>

<%= render Admin::DrawerComponent.new(
  name: drawer_id,
  title: title,
  hint: hint,
  placement: placement,
  scroll: scroll,
  backdrop: backdrop,
  closeable: closeable,
  auto_open: auto_open
) do %>
  <div class="d-grid gap-3">
    <p class="mb-0">
      This is an example of drawer content in NASA Missions.
    </p>

    <div>
      <label class="form-label" for="<%= drawer_id %>-example">
        Workflow name
      </label>

      <input
        id="<%= drawer_id %>-example"
        type="text"
        class="form-control"
        value="Summer creator campaign"
      >
    </div>

    <button type="button" class="btn btn-primary">
      Save changes
    </button>
  </div>
<% end %>