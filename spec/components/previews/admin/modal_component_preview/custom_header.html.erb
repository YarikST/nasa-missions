<button
  type="button"
  class="btn btn-primary"
  data-bs-toggle="modal"
  data-bs-target="#custom-header-modal"
>
  Open modal
</button>

<%= render Admin::ModalComponent.new(
  name: "custom-header-modal"
) do |modal| %>
  <% modal.with_header do %>
    <div class="modal-header">
      <div>
        <h1 class="modal-title fs-5">
          Custom header
        </h1>

        <p class="text-body-secondary small mb-0 mt-1">
          Custom content inside the modal header.
        </p>
      </div>

      <button
        type="button"
        class="btn-close"
        data-bs-dismiss="modal"
        aria-label="Close"
      ></button>
    </div>
  <% end %>

  <p class="mb-0">
    This modal uses a custom header slot.
  </p>

  <% modal.with_footer do %>
    <button
      type="button"
      class="btn btn-outline-secondary"
      data-bs-dismiss="modal"
    >
      Cancel
    </button>

    <button type="button" class="btn btn-primary">
      Save
    </button>
  <% end %>
<% end %>