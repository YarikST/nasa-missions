<button
  type="button"
  class="btn btn-primary"
  data-bs-toggle="modal"
  data-bs-target="#<%= modal_id %>"
>
  Open modal
</button>

<%= render Admin::ModalComponent.new(
  name: modal_id,
  title: title,
  hint: hint,
  size: size,
  backdrop: backdrop,
  closeable: closeable,
  data: {
    bs_keyboard: closeable
  }
) do |modal| %>
  <p class="mb-0">
    This is an example of modal content in NASA Missions.
  </p>

  <% if show_footer %>
    <% modal.with_footer do %>
      <button
        type="button"
        class="btn btn-outline-secondary"
        data-bs-dismiss="modal"
      >
        Cancel
      </button>

      <button type="button" class="btn btn-primary">
        Save
      </button>
    <% end %>
  <% end %>
<% end %>