<%= render Admin::CardComponent.new(
  html_attributes: {
    class: "shadow-sm",
    style: "max-width: 32rem;"
  }
) do |card| %>
  <% card.with_header do %>
    <div class="d-flex align-items-center justify-content-between">
      <h2 class="h5 mb-0">Campaign summary</h2>
      <span class="badge text-bg-success">Active</span>
    </div>
  <% end %>

  <p class="mb-0">
    Card content
  </p>

  <% card.with_footer do %>
    <%= render Admin::ButtonComponent.new(size: :sm) do %>
      Continue
    <% end %>
  <% end %>
<% end %>
