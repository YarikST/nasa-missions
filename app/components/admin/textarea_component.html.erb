<div class="mb-3" data-controller="textarea-counter">
  <% if title.present? %>
    <label for="<%= input_id %>" class="form-label">
      <%= title %>

      <% if optional? %>
        <span class="text-body-secondary fw-normal">
          Optional
        </span>
      <% end %>
    </label>
  <% end %>

  <textarea
    id="<%= input_id %>"
    name="<%= name %>"
    placeholder="<%= placeholder %>"
    class="<%= input_classes %>"
    autocomplete="<%= autocomplete %>"
    maxlength="<%= maxlength %>"
    rows="<%= rows %>"
    <%= tag.attributes(data: input_data) %>
    <%= tag.attributes(html_attributes) %>
    <%= "disabled" if disabled? %>
    <%= "required" unless optional? %>
  ><%= value %></textarea>

  <div class="d-flex justify-content-between align-items-start gap-3">
    <% if hint.present? && !invalid? %>
      <div class="form-text">
        <%= hint %>
      </div>
    <% end %>

    <div
      class="form-text text-nowrap ms-auto"
      data-textarea-counter-target="counter"
    >
      <%= current_length %>/<%= maxlength %>
    </div>
  </div>

  <% errors.each do |error| %>
    <div class="invalid-feedback d-block">
      <%= error %>
    </div>
  <% end %>
</div>