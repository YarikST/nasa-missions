<%= tag.div(
  id: name,
  class: modal_classes,
  tabindex: "-1",
  data: modal_data,
  aria: modal_aria,
  **modal_html_attributes
) do %>
  <div class="<%= dialog_classes %>">
    <div class="modal-content">
      <% if header? %>
        <%= header %>
      <% else %>
        <div class="modal-header">
          <div>
            <% if title.present? %>
              <h1 id="<%= title_id %>" class="modal-title fs-5">
                <%= title %>
              </h1>
            <% end %>

            <% if hint.present? %>
              <p class="text-body-secondary small mb-0 mt-1">
                <%= hint %>
              </p>
            <% end %>
          </div>

          <% if closeable? %>
            <button
              type="button"
              class="btn-close"
              data-bs-dismiss="modal"
              aria-label="Close"
            ></button>
          <% end %>
        </div>
      <% end %>

      <div class="modal-body">
        <%= content %>
      </div>

      <% if footer? %>
        <div class="modal-footer">
          <%= footer %>
        </div>
      <% end %>
    </div>
  </div>
<% end %>