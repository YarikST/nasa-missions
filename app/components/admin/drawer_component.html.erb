<%= tag.div(
  id: name,
  class: drawer_classes,
  tabindex: "-1",
  data: drawer_data,
  aria: {
    labelledby: title.present? ? title_id : nil
  }.compact,
  **drawer_html_attributes
) do %>
  <% if title.present? || closeable? %>
    <div class="offcanvas-header">
      <% if title.present? %>
        <h2 id="<%= title_id %>" class="offcanvas-title fs-5">
          <%= title %>
        </h2>
      <% end %>

      <% if closeable? %>
        <button
          type="button"
          class="btn-close"
          data-bs-dismiss="offcanvas"
          aria-label="Close"
        ></button>
      <% end %>
    </div>
  <% end %>

  <div class="offcanvas-body">
    <% if hint.present? %>
      <div class="alert alert-light border small mb-3" role="note">
        <%= hint %>
      </div>
    <% end %>

    <%= content %>
  </div>
<% end %>