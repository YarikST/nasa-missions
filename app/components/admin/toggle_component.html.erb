<div class="form-check form-switch mb-3">
  <input
    type="hidden"
    name="<%= name %>"
    value="0"
    <%= "disabled" if disabled? %>
  >

  <input
    id="<%= input_id %>"
    name="<%= name %>"
    type="checkbox"
    role="switch"
    value="<%= value %>"
    class="<%= input_classes %>"
    <%= tag.attributes(data: data) %>
    <%= tag.attributes(html_attributes) %>
    <%= "checked" if checked? %>
    <%= "disabled" if disabled? %>
  >

  <% if title.present? %>
    <label class="form-check-label" for="<%= input_id %>">
      <%= title %>
    </label>
  <% end %>

  <% if hint.present? && !invalid? %>
    <div class="form-text">
      <%= hint %>
    </div>
  <% end %>

  <% errors.each do |error| %>
    <div class="invalid-feedback d-block">
      <%= error %>
    </div>
  <% end %>
</div>