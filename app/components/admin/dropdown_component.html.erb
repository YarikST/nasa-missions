<div class="mb-3">
  <% if title.present? %>
    <label for="<%= input_id %>" class="form-label">
      <%= title %>

      <% if optional? %>
        <span class="text-body-secondary fw-normal">
          Optional
        </span>
      <% end %>
    </label>
  <% end %>

  <select
    id="<%= input_id %>"
    name="<%= name %>"
    class="<%= select_classes %>"
    <%= tag.attributes(data: data) %>
    <%= tag.attributes(html_attributes) %>
    <%= "disabled" if disabled? %>
    <%= "required" unless optional? %>
  >
    <% if placeholder.present? %>
      <option
        value=""
        <%= "selected" if value.blank? %>
        <%= "disabled" unless optional? %>
      >
        <%= placeholder %>
      </option>
    <% end %>

    <%= options_for_select(options, value) %>
  </select>

  <% if hint.present? && !invalid? %>
    <div class="form-text">
      <%= hint %>
    </div>
  <% end %>

  <% errors.each do |error| %>
    <div class="invalid-feedback d-block">
      <%= error %>
    </div>
  <% end %>
</div>