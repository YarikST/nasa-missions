<% if path.present? && method == :get %>
  <%= link_to path, class: button_classes do %>
    <%= button_content %>
  <% end %>
<% elsif path.present? %>
  <%= button_to path, method: method, class: button_classes,
    form: { class: "d-inline", data: { turbo_confirm: confirm }.compact } do %>
    <%= button_content %>
  <% end %>
<% else %>
  <%= tag.button type: type, class: button_classes, disabled: disabled do %>
    <%= button_content %>
  <% end %>
<% end %>
