<div class="mb-3">
  <label for="<%= input_id %>" class="form-label"><%= title %></label>
  <%= tag.input(
    id: input_id,
    name: name,
    type: type,
    value: value,
    placeholder: placeholder,
    class: class_names("form-control", "is-invalid": errors.any?),
    required: true,
    data: data,
    **html_attributes
  ) %>
  <% if hint.present? && errors.empty? %>
    <div class="form-text"><%= hint %></div>
  <% end %>
  <% errors.each do |error| %>
    <div class="invalid-feedback d-block"><%= error %></div>
  <% end %>
</div>
