<% if disabled? %>
  <%= tag.span(
        content,
        class: disabled_classes,
        data: data,
        **disabled_html_attributes
      ) %>
<% else %>
  <%= link_to(
        content,
        path,
        target: target,
        rel: rel,
        class: link_classes,
        data: data,
        **link_html_attributes
      ) %>
<% end %>