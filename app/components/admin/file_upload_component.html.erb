<div class="mb-3" <%= tag.attributes(data: container_data) %>>
  <% if title.present? %>
    <label for="<%= input_id %>" class="form-label">
      <%= title %>

      <% if optional? %>
        <span class="text-body-secondary fw-normal">
          Optional
        </span>
      <% end %>
    </label>
  <% end %>

  <label
    for="<%= input_id %>"
    class="<%= dropzone_classes %>"
    data-file-upload-target="dropContainer"
    data-action="
      dragover->file-upload#dragover
      dragenter->file-upload#dragenter
      dragleave->file-upload#dragleave
      drop->file-upload#drop
    "
  >
    <input
      id="<%= input_id %>"
      name="<%= name %>"
      type="file"
      accept="<%= accept %>"
      class="visually-hidden"
      <%= tag.attributes(data: input_data) %>
      <%= tag.attributes(html_attributes) %>
      <%= "multiple" if multiple? %>
      <%= "disabled" if disabled? %>
      <%= "required" unless optional? %>
    >

    <div class="d-flex flex-column align-items-center gap-2">
      <i class="bi bi-cloud-arrow-up fs-2" aria-hidden="true"></i>

      <span class="fw-semibold">
        <%= prompt %>
      </span>
    </div>
  </label>

  <% if hint.present? && !invalid? %>
    <div class="form-text">
      <%= hint %>
    </div>
  <% end %>

  <div
    class="d-grid gap-2 mt-3"
    data-file-upload-target="preview"
  ></div>

  <% errors.each do |error| %>
    <div class="invalid-feedback d-block">
      <%= error %>
    </div>
  <% end %>
</div>