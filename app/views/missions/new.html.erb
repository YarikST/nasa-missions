<% content_for :title, "Create mission · NASA Missions" %>

<div class="mb-4">
  <%= link_to root_path, class: "link-secondary text-decoration-none small" do %>
    <i class="bi bi-arrow-left" aria-hidden="true"></i> All missions
  <% end %>
  <h1 class="mt-3 mb-2">Create a mission</h1>
  <p class="text-body-secondary mb-0">Save the mission first, then build its flight path.</p>
</div>

<%= render Admin::FlashComponent.new(notice: notice, alert: alert) %>

<div class="row g-4 align-items-start">
  <div class="col-lg-8">
    <%= render "details_form", mission: @mission %>
    <div class="mt-4">
      <%= render Admin::CardComponent.new(title: "Flight path", description: "Create the mission to start adding route steps.") do %>
        <%= render Admin::ButtonComponent.new(type: :button, variant: :outline_secondary, icon: "plus-lg", disabled: true) do %>
          Add step
        <% end %>
      <% end %>
    </div>
  </div>
  <div class="col-lg-4">
    <%= render "fuel_estimate", fuel: nil, message: "Save the mission to start calculating fuel." %>
  </div>
</div>
