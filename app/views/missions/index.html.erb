<% content_for :title, "Missions · NASA Missions" %>

<div class="d-flex flex-wrap align-items-start justify-content-between gap-3 mb-4">
  <div>
    <h1 class="mb-2">NASA Missions</h1>
    <p class="text-body-secondary mb-0">Plan journeys and review the fuel each mission needs.</p>
  </div>
  <%= render Admin::ButtonComponent.new(path: new_mission_path, icon: "plus-lg") do %>
    New mission
  <% end %>
</div>

<%= render Admin::FlashComponent.new(notice: notice) %>

<%= render Admin::CardComponent.new(title: "Missions") do %>
  <% if @missions.any? %>
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead>
          <tr>
            <th scope="col">Mission</th>
            <th scope="col">Equipment mass</th>
            <th scope="col">Steps</th>
            <th scope="col">Fuel required</th>
            <th scope="col" class="text-end">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% @missions.each do |mission| %>
            <tr>
              <td class="fw-medium"><%= link_to mission.name, mission, class: "text-decoration-none" %></td>
              <td><%= number_with_delimiter(mission.equipment_mass) %> kg</td>
              <td><%= mission.mission_steps.size %></td>
              <td class="fw-semibold"><%= number_with_delimiter(@fuel_by_mission_id.fetch(mission.id)) %> kg</td>
              <td>
                <div class="d-flex flex-wrap justify-content-end gap-2">
                  <%= render Admin::ButtonComponent.new(path: mission_path(mission), size: :sm, variant: :outline_secondary) do %>
                    View
                  <% end %>
                  <%= render Admin::ButtonComponent.new(path: edit_mission_path(mission), size: :sm, variant: :outline_secondary) do %>
                    Edit
                  <% end %>
                  <%= render Admin::ButtonComponent.new(
                    path: mission_path(mission),
                    method: :delete,
                    size: :sm,
                    variant: :outline_danger,
                    confirm: "Delete #{mission.name}? This cannot be undone."
                  ) do %>
                    Delete
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="text-center py-5">
      <i class="bi bi-rocket-takeoff fs-1 text-body-secondary" aria-hidden="true"></i>
      <h2 class="h5 mt-3">No missions yet</h2>
      <p class="text-body-secondary">Create a mission to start planning its flight path.</p>
      <%= render Admin::ButtonComponent.new(path: new_mission_path, icon: "plus-lg") do %>
        Create a mission
      <% end %>
    </div>
  <% end %>
<% end %>
